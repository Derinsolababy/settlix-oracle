NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Stellar. Horizon and RPC URLs default to SDF's endpoints for the network.
STELLAR_NETWORK=testnet
# STELLAR_HORIZON_URL=
# SOROBAN_RPC_URL=
# USDC_ISSUER=  defaults to Circle's issuer for the network

# Settlix contracts (from settlix-contracts/deployments/<network>.json).
# With SETTLEMENT_CONTRACT_ID set, the fee rate is read on-chain; FEE_BPS is
# used only when it is not.
PAYMENT_CONTRACT_ID=CBT5VKCQXUGQ3JXBJOQXJPRWXWGBWFAQ5UZ3S4V66H7W7IWRUSPZ7IUQ
SETTLEMENT_CONTRACT_ID=CAUKU4RFZXVXZW6ED6DR5BRWAHFHPUH662IGPEZF7SO553XXWFQBCFEV
FEE_BPS=50

# Stellar secret seed that signs quotes. Required in production; without it
# a throwaway key is generated at each start. Generate: stellar keys generate
ORACLE_SECRET=
QUOTE_TTL_SECONDS=120

# Prices. CoinGecko works without a key at low volume; a demo or pro key
# raises the limit (set COINGECKO_PRO=true for a pro key).
COINGECKO_API_KEY=
COINGECKO_PRO=false
PRICE_POLL_MS=30000
PRICE_MAX_AGE_MS=120000
PRICE_MAX_SPREAD_BPS=300
